# ==============================
# ComunIA - Configuración ejemplo
# ==============================

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Groq (Free tier disponible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Tarifa pública de referencia por 1M tokens.
# En Free tier el coste facturado puede ser 0; se mantienen estos valores
# para mostrar una estimación comparable en la rúbrica del proyecto.
GROQ_INPUT_COST_PER_1M=0.80
GROQ_OUTPUT_COST_PER_1M=4.00

# Proveedor automático utilizado en la vista operativa
DEFAULT_TRIAGE_PROVIDER=ollama

# Parámetros de decodificación
TEMPERATURE=0.1
TOP_P=0.9

# Robustez
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
MAX_REPAIR_ATTEMPTS=2

# URL que utiliza Streamlit para hablar con FastAPI
COMUNIA_API_URL=http://localhost:8000/api/v1
