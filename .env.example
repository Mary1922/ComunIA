# ==============================
# ComunIA - Configuración ejemplo
# ==============================

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Coste por 1M tokens del modelo configurado.
# Actualízalos si cambias OPENAI_MODEL.
OPENAI_INPUT_COST_PER_1M=0.20
OPENAI_OUTPUT_COST_PER_1M=1.20

# Parámetros de decodificación
TEMPERATURE=0.1
TOP_P=0.9

# Robustez
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
MAX_REPAIR_ATTEMPTS=2

# URL que utiliza Streamlit para hablar con FastAPI
COMUNIA_API_URL=http://localhost:8000/api/v1
